diff --git a/ds4.c b/ds4.c
index 4ea94f7..deb2c01 100644
--- a/ds4.c
+++ b/ds4.c
@@ -61060,13 +61060,85 @@ static bool mellum_stream_cancelled(void *ctx) {
     return g->mellum_stream_cancel && g->mellum_stream_cancel(g->mellum_stream_cancel_ud);
 }
 
+/* SCREEN ONLY (not committed to product): DS4_MELLUM_STREAM_PROFILE times each callback of a streamed decode
+ * token and prints per-token totals at exit; DS4_MELLUM_STREAM_PROFILE_ROUNDS also logs every round and stop. */
+#include <time.h>
+static struct { double enc, fin, begin, wait, tok; uint64_t nenc, nfin, nstop, ntok, layers, loads; } g_msp;
+static int g_msp_rounds;
+static double msp_now(void) { struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t); return t.tv_sec * 1e3 + t.tv_nsec / 1e6; }
+static void msp_report(void) {
+    if (!g_msp.ntok) return;
+    const double n = (double)g_msp.ntok;
+    fprintf(stderr, "mellum_stream_profile tokens %llu encodes %llu finishes %llu stops %llu layers_encoded %llu "
+            "experts_loaded %llu | per token ms: total %.3f encode %.3f finish %.3f load_begin %.3f load_wait %.3f "
+            "other %.3f\n", (unsigned long long)g_msp.ntok, (unsigned long long)g_msp.nenc,
+            (unsigned long long)g_msp.nfin, (unsigned long long)g_msp.nstop, (unsigned long long)g_msp.layers,
+            (unsigned long long)g_msp.loads, g_msp.tok / n, g_msp.enc / n, g_msp.fin / n, g_msp.begin / n,
+            g_msp.wait / n, (g_msp.tok - g_msp.enc - g_msp.fin - g_msp.begin - g_msp.wait) / n);
+}
+static bool msp_on(void) {
+    static int v = -1;
+    if (v < 0) {
+        v = getenv("DS4_MELLUM_STREAM_PROFILE") != NULL;
+        g_msp_rounds = v && getenv("DS4_MELLUM_STREAM_PROFILE_ROUNDS") != NULL;
+        if (v) atexit(msp_report);
+    }
+    return v;
+}
+typedef struct { mellum_stream_ctx *c; uint32_t from; double enc_ms, begin_ms; uint64_t loads0; } msp_ctx;
+static bool msp_encode(void *ctx, uint32_t from, bool resume) {
+    msp_ctx *p = ctx;
+    const double t = msp_now();
+    const bool ok = mellum_stream_encode(p->c, from, resume);
+    p->enc_ms = msp_now() - t;
+    g_msp.enc += p->enc_ms; g_msp.nenc++; g_msp.layers += DS4_N_LAYER - from; p->from = from;
+    return ok;
+}
+static bool msp_finish(void *ctx, bool *stopped, ds4_mellum_stream_stop *stop) {
+    msp_ctx *p = ctx;
+    const double t = msp_now();
+    const bool ok = mellum_stream_finish(p->c, stopped, stop);
+    const double dt = msp_now() - t;
+    g_msp.fin += dt; g_msp.nfin++;
+    if (g_msp_rounds && ok) fprintf(stderr, "msp_round from %u to %u stopped %d fin_ms %.4f\n", p->from,
+                                    *stopped ? stop->layer : DS4_N_LAYER, (int)*stopped, dt);
+    return ok;
+}
+static bool msp_load_begin(void *ctx, uint32_t layer, const int32_t *ids, uint32_t n) {
+    msp_ctx *p = ctx;
+    p->loads0 = p->c->g->mellum_stream_loads;
+    const double t = msp_now();
+    const bool ok = mellum_stream_load_begin(p->c, layer, ids, n);
+    p->begin_ms = msp_now() - t;
+    g_msp.begin += p->begin_ms;
+    return ok;
+}
+static bool msp_load(void *ctx, uint32_t layer, const int32_t *ids, uint32_t n) {
+    msp_ctx *p = ctx;
+    const double t = msp_now();
+    const bool ok = mellum_stream_load(p->c, layer, ids, n);
+    const double dt = msp_now() - t;
+    const uint64_t loaded = p->c->g->mellum_stream_loads - p->loads0;
+    g_msp.wait += dt; g_msp.nstop++; g_msp.loads += loaded;
+    if (g_msp_rounds) fprintf(stderr, "msp_stop layer %u loaded %llu begin_ms %.4f encode_ms %.4f wait_ms %.4f\n",
+                              layer, (unsigned long long)loaded, p->begin_ms, p->enc_ms, dt);
+    return ok;
+}
+static bool msp_cancelled(void *ctx) { return mellum_stream_cancelled(((msp_ctx *)ctx)->c); }
+static void msp_discard(void *ctx) { mellum_stream_discard(((msp_ctx *)ctx)->c); }
+
 static bool mellum_stream_decode(ds4_qwen4_gpu_graph *g, const ds4_model *m, const ds4_weights *w, int32_t token,
                                  float *logits_out) {
     mellum_stream_ctx c = { g, m, w, token };
-    const ds4_mellum_stream_ops ops = { &c, mellum_stream_encode, mellum_stream_finish, mellum_stream_load,
-                                        mellum_stream_cancelled, mellum_stream_load_begin, mellum_stream_discard };
+    msp_ctx pc = { &c, 0, 0, 0, 0 };
+    const double msp_t0 = msp_on() ? msp_now() : 0;
+    const ds4_mellum_stream_ops ops = msp_on()
+        ? (ds4_mellum_stream_ops){ &pc, msp_encode, msp_finish, msp_load, msp_cancelled, msp_load_begin, msp_discard }
+        : (ds4_mellum_stream_ops){ &c, mellum_stream_encode, mellum_stream_finish, mellum_stream_load,
+                                   mellum_stream_cancelled, mellum_stream_load_begin, mellum_stream_discard };
     uint32_t stops = 0;
     const int rc = ds4_mellum_stream_decode(&ops, DS4_N_LAYER, &stops);
+    if (msp_on()) { g_msp.tok += msp_now() - msp_t0; g_msp.ntok++; }
     if (ds4_gpu_commands_active()) (void)ds4_gpu_end_commands();
     (void)ds4_gpu_stream_gate_bind(NULL);
     g->mellum_stream_resume = UINT32_MAX;
