+static double msp_now(void) { struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t); return t.tv_sec * 1e3 + t.tv_nsec / 1e6; }
+static void msp_report(void) {
+    if (!g_msp_ntok) return;
+    fprintf(stderr, "mellum_stream_profile tokens %llu encodes %llu layers_encoded %llu loads_calls %llu | per token ms: total %.3f encode %.3f finish %.3f load %.3f other %.3f\n",
