+            (g_msp_tok - g_msp_enc - g_msp_fin - g_msp_load) / g_msp_ntok);
+}
+static bool msp_on(void) { static int v = -1; if (v < 0) { v = getenv("DS4_MELLUM_STREAM_PROFILE") != NULL; if (v) atexit(msp_report); } return v; }
+
+static bool mellum_stream_encode_impl(void *ctx, uint32_t from_layer, bool resume);
 static bool mellum_stream_encode(void *ctx, uint32_t from_layer, bool resume) {
