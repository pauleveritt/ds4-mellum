+                            const int32_t *keep, uint32_t keep_n, uint32_t *loaded);
+static uint64_t g_screen_prefetched;
+static void screen_prefetch_report(void) { fprintf(stderr, "screen_prefetch loaded %llu\n", (unsigned long long)g_screen_prefetched); }
 static bool mellum_stream_load(void *ctx, uint32_t layer, const int32_t *ids, uint32_t n) {
