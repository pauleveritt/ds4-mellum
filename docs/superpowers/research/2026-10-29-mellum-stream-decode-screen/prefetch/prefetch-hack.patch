+    if (!mellum_stream_load_ids(c->m, &c->w->layer[layer], layer, ids, n, &c->g->mellum_stream_loads)) return false;
+    static int on = -1;
+    if (on < 0) { on = getenv("SCREEN_PREFETCH") != NULL; if (on) atexit(screen_prefetch_report); }
+    if (!on || layer + 1u >= DS4_N_LAYER || n > 8u) return true;
+    const uint32_t E = DS4_N_EMBD;
+    float x[8192];
+    if (E > 8192u || !ds4_gpu_tensor_read(c->g->mellum_scratch[MELLUM_S_FFN_NORM], 0, x, (uint64_t)E * sizeof(float))) return true;
+    const ds4_layer_weights *l1 = &c->w->layer[layer + 1u];
