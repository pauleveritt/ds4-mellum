+    float logit[64]; int32_t top[8];
+    for (uint32_t e = 0; e < 64u; e++) { double a = 0; for (uint32_t i = 0; i < E; i++) a += (double)router[(uint64_t)e * E + i] * x[i]; logit[e] = (float)a; }
+    for (uint32_t k = 0; k < 8u; k++) { int32_t best = -1; for (int32_t e = 0; e < 64; e++) { bool used = false; for (uint32_t j = 0; j < k; j++) used |= top[j] == e; if (!used && (best < 0 || logit[e] > logit[best])) best = e; } top[k] = best; }
+    uint64_t gate_bytes = 0, down_bytes = 0;
